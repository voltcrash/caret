MODE=dev
FRONTEND_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000/api/auth
BETTER_AUTH_SECRET=oxytype-local-development-secret-only
# Cloudflare dummy key, accepted only in MODE=dev. Use a real secret on staging/production.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Google/GitHub callbacks: BETTER_AUTH_URL/callback/google (or /github)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# Optional external HTTPS bridge (see docs/CLOUDFLARE_OPERATIONS.md)
# INTEGRATION_URL=
# INTEGRATION_SECRET=
