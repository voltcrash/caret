{
  "name": "@oxytype/backend",
  "version": "1.14.3",
  "private": true,
  "license": "GPL-3.0",
  "exports": {
    "./runtime": "./src/runtime/env.ts",
    "./jobs": "./src/runtime/tasks.ts",
    "./rate-counter": "./src/policies/rate-counter.ts",
    "./client-ip": "./src/policies/client-ip.ts",
    "./auth": "./src/auth/handler.ts",
    "./ip-key": "./src/policies/ip-key.ts",
    "./auth/session": "./src/init/auth.ts",
    "./policies/operations": "./src/policies/operations.ts",
    "./policies/authentication": "./src/policies/authentication.ts",
    "./policies/configuration": "./src/policies/configuration.ts",
    "./policies/permission": "./src/policies/permission.ts",
    "./policies/rate-limit": "./src/policies/rate-limit.ts",
    "./policies/operation-runner": "./src/policies/operation-runner.ts",
    "./configuration": "./src/init/configuration.ts",
    "./services/context": "./src/services/context.ts",
    "./services/public-operations": "./src/services/operations/public.ts",
    "./services/user-data": "./src/services/operations/user/data.ts",
    "./errors": "./src/utils/error.ts",
    "./audit": "./src/dal/logs.ts",
    "./services/account": "./src/services/operations/user/account.ts",
    "./services/admin": "./src/services/operations/admin.ts",
    "./services/profile": "./src/services/operations/user/profile.ts",
    "./services/leaderboards": "./src/services/operations/leaderboard.ts",
    "./auth/ui-session": "./src/auth/ui-session.ts",
    "./http": "./src/http/handler.ts",
    "./http/openapi": "./src/http/openapi.ts"
  },
  "scripts": {
    "lint": "vp lint . --type-aware --type-check --format agent",
    "lint-fast": "vp lint . --format agent",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "ts-check": "vp lint . --type-aware --type-check --format agent",
    "test": "vp test run --project=!d1",
    "integration-test": "vp test run --project=d1",
    "test-coverage": "vp test run --config coverage.config.ts --coverage",
    "anticheat:calibrate": "vpx ./scripts/anticheat-calibrate.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply oxytype-staging --local",
    "db:bootstrap:production": "wrangler d1 execute oxytype-production --remote --config ../frontend/wrangler.production.json --file bootstrap/production.sql",
    "migration-inventory": "vpx ./scripts/migration-inventory.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.7",
    "@better-auth/infra": "0.4.14",
    "@date-fns/utc": "2.1.1",
    "@oxytype/contracts": "workspace:*",
    "@oxytype/funbox": "workspace:*",
    "@oxytype/schemas": "workspace:*",
    "@oxytype/typing-engine": "workspace:*",
    "@oxytype/util": "workspace:*",
    "@ts-rest/core": "3.52.1",
    "@ts-rest/open-api": "3.52.1",
    "better-auth": "1.7.7",
    "date-fns": "4.4.0",
    "drizzle-orm": "0.45.3",
    "object-hash": "3.0.0",
    "qs": "6.16.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261001.1",
    "@oxytype/oxlint-config": "workspace:*",
    "@oxytype/typescript-config": "workspace:*",
    "@types/node": "24.19.0",
    "@types/object-hash": "3.0.6",
    "@types/qs": "6.15.1",
    "@vitest/coverage-v8": "catalog:",
    "drizzle-kit": "0.31.11",
    "miniflare": "5.20261001.0-alpha",
    "typescript": "7.0.2",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "wrangler": "4.146.0"
  },
  "engines": {
    "node": ">=24.21.0 <25"
  }
}
