{
  "name": "oxytype",
  "private": true,
  "license": "GPL-3.0",
  "type": "module",
  "scripts": {
    "full-check": "vp run lint && vp run build && vp run test && vp run lint-styles && vp run check-assets",
    "prepare": "vp config --no-agent",
    "ts-check": "vp run --filter \"!oxytype\" ts-check",
    "lint": "vp run --filter \"!oxytype\" lint",
    "lint-check-config": "node packages/oxlint-config/check-application-defaults.ts",
    "lint-suppressions": "vp exec node packages/oxlint-config/audit-suppressions.ts",
    "lint-be": "vp run --filter @oxytype/backend lint",
    "lint-fe": "vp run --filter @oxytype/frontend lint",
    "lint-pkg": "vp run --filter \"./packages/*\" lint",
    "lint-fix": "vp run --filter \"!oxytype\" lint --fix",
    "lint-fast": "vp run --filter \"!oxytype\" lint-fast",
    "lint-fast-be": "vp run --filter @oxytype/backend lint-fast",
    "lint-fast-fe": "vp run --filter @oxytype/frontend lint-fast",
    "lint-fast-pkg": "vp run --filter \"./packages/*\" lint-fast",
    "build": "vp run --filter @oxytype/frontend build",
    "build-fe": "vp run --filter @oxytype/frontend build",
    "test": "vp test run",
    "test-be": "vp test run --project=*-backend",
    "test-fe": "vp test run --project=*-frontend",
    "test-e2e": "vp run --filter @oxytype/frontend test-e2e",
    "test-pkg": "vp test run --project=@oxytype/*",
    "dev": "vp run dev-fe",
    "dev-fe": "vp run --filter @oxytype/frontend dev",
    "storybook": "vp run --filter @oxytype/frontend storybook",
    "start": "vp run build && vp run --filter @oxytype/frontend start",
    "format-check": "vp fmt . --check",
    "format-fix": "vp fmt .",
    "lint-styles": "stylelint \"**/*.css\"",
    "lint-styles-fix": "stylelint \"**/*.css\" --fix",
    "check-assets": "vp run --filter @oxytype/frontend check-assets",
    "check-assets-quotes": "vp run --filter @oxytype/frontend check-assets quotes",
    "check-assets-languages": "vp run --filter @oxytype/frontend check-assets languages",
    "check-assets-others": "vp run --filter @oxytype/frontend check-assets others",
    "check-assets-json": "vp run --filter @oxytype/frontend check-assets json",
    "knip": "knip",
    "oxlint": "vp lint",
    "engine:build": "node scripts/engine.ts build",
    "engine:test": "node scripts/engine.ts test",
    "engine:lint": "node scripts/engine.ts lint",
    "engine:fmt": "node scripts/engine.ts fmt",
    "engine:fmt-fix": "node scripts/engine.ts fmt-fix",
    "engine:test:wasm": "node scripts/engine.ts browser",
    "engine:parity": "node scripts/engine.ts parity",
    "terminal:dev": "node scripts/terminal.ts dev",
    "terminal:build": "node scripts/terminal.ts build",
    "terminal:test": "node scripts/terminal.ts test",
    "terminal:test:pty": "node scripts/terminal.ts pty",
    "terminal:test:emulator": "node scripts/terminal.ts emulator",
    "terminal:package": "node scripts/terminal.ts package",
    "terminal:source": "node scripts/terminal.ts source",
    "terminal:archive-smoke": "node scripts/terminal.ts archive-smoke",
    "terminal:release-gate": "node scripts/terminal.ts release-gate",
    "terminal:test:release-tools": "node scripts/terminal.ts tools-test"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@types/node": "24.19.0",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "binaryen": "132.0.0",
    "caniuse-lite": "1.0.30001814",
    "conventional-changelog-conventionalcommits": "10.4.0",
    "knip": "6.39.0",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "packageManager": "pnpm@12.8.1"
}
