    },
    {
      "name": "RATE_LIMIT_60S_67",
      "namespace_id": "1012",
      "simple": {
        "limit": 67,
        "period": 60
      }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "oxytype-production",
      "database_id": "43d104e9-2fef-43db-95d7-c64a08310714",
      "migrations_dir": "../backend/migrations"
    }
  ],
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true
}
