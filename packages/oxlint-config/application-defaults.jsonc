// App configs opt into shared rules; overrides cannot set categories.
// Regenerate after tool upgrades: vp run lint-check-config --write
{
  "rules": {
    "block-scoped-var": "off",
    "constructor-super": "off",
    "for-direction": "off",
    "getter-return": "off",
    "no-async-promise-executor": "off",
    "no-caller": "off",
    "no-class-assign": "off",
    "no-compare-neg-zero": "off",
    "no-cond-assign": "off",
    "no-const-assign": "off",
    "no-control-regex": "off",
    "no-debugger": "off",
    "no-delete-var": "off",
    "no-dupe-class-members": "off",
    "no-dupe-else-if": "off",
    "no-dupe-keys": "off",
    "no-duplicate-case": "off",
    "no-empty-character-class": "off",
    "no-empty-pattern": "off",
    "no-empty-static-block": "off",
    "no-eval": "off",
    "no-ex-assign": "off",
    "no-extend-native": "off",
    "no-extra-bind": "off",
    "no-extra-boolean-cast": "off",
    "no-func-assign": "off",
    "no-global-assign": "off",
    "no-implied-eval": "off",
    "no-import-assign": "off",
    "no-invalid-regexp": "off",
    "no-irregular-whitespace": "off",
    "no-iterator": "off",
    "no-loss-of-precision": "off",
    "no-misleading-character-class": "off",
    "no-new-native-nonconstructor": "off",
    "no-nonoctal-decimal-escape": "off",
    "no-obj-calls": "off",
    "no-self-assign": "off",
    "no-setter-return": "off",
    "no-shadow": "off",
    "no-shadow-restricted-names": "off",
    "no-sparse-arrays": "off",
    "no-this-before-super": "off",
    "no-unexpected-multiline": "off",
    "no-unmodified-loop-condition": "off",
    "no-unneeded-ternary": "off",
    "no-unreachable": "off",
    "no-unsafe-finally": "off",
    "no-unsafe-negation": "off",
    "no-unsafe-optional-chaining": "off",
    "no-unused-labels": "off",
    "no-unused-private-class-members": "off",
    "no-useless-backreference": "off",
    "no-useless-call": "off",
    "no-useless-catch": "off",
    "no-useless-concat": "off",
    "no-useless-escape": "off",
    "no-useless-rename": "off",
    "no-with": "off",
    "require-yield": "off",
    "use-isnan": "off",
    "valid-typeof": "off",
    "import/default": "off",
    "import/namespace": "off",
    "import/no-absolute-path": "off",
    "import/no-empty-named-blocks": "off",
    "import/no-self-import": "off",
    "node/no-exports-assign": "off",
    "oxc/approx-constant": "off",
    "oxc/bad-array-method-on-arguments": "off",
    "oxc/bad-char-at-comparison": "off",
    "oxc/bad-comparison-sequence": "off",
    "oxc/bad-match-all-arg": "off",
    "oxc/bad-min-max-func": "off",
    "oxc/bad-object-literal-comparison": "off",
    "oxc/bad-replace-all-arg": "off",
    "oxc/const-comparisons": "off",
    "oxc/double-comparisons": "off",
    "oxc/erasing-op": "off",
    "oxc/misrefactored-assign-op": "off",
    "oxc/missing-throw": "off",
    "oxc/no-accumulating-spread": "off",
    "oxc/no-this-in-exported-function": "off",
    "oxc/number-arg-out-of-range": "off",
    "oxc/only-used-in-recursion": "off",
    "oxc/uninvoked-array-callback": "off",
    "promise/no-callback-in-promise": "off",
    "promise/no-multiple-resolved": "off",
    "promise/no-new-statics": "off",
    "promise/no-promise-in-callback": "off",
    "promise/valid-params": "off",
    "typescript/consistent-return": "off",
    "typescript/no-confusing-non-null-assertion": "off",
    "typescript/no-duplicate-enum-values": "off",
    "typescript/no-extra-non-null-assertion": "off",
    "typescript/no-generated-empty-object-type": "off",
    "typescript/no-misused-new": "off",
    "typescript/no-misused-spread": "off",
    "typescript/no-non-null-asserted-optional-chain": "off",
    "typescript/no-unnecessary-parameter-property-assignment": "off",
    "typescript/no-unnecessary-type-parameters": "off",
    "typescript/no-unsafe-declaration-merging": "off",
    "typescript/no-useless-empty-export": "off",
    "typescript/no-wrapper-object-types": "off",
    "typescript/prefer-as-const": "off",
    "typescript/triple-slash-reference": "off",
    "unicorn/no-accessor-recursion": "off",
    "unicorn/no-array-fill-with-reference-type": "off",
    "unicorn/no-await-in-promise-methods": "off",
    "unicorn/no-confusing-array-with": "off",
    "unicorn/no-empty-file": "off",
    "unicorn/no-instanceof-builtins": "off",
    "unicorn/no-invalid-fetch-options": "off",
    "unicorn/no-invalid-remove-event-listener": "off",
    "unicorn/no-single-promise-in-promise-methods": "off",
    "unicorn/no-thenable": "off",
    "unicorn/no-unnecessary-await": "off",
    "unicorn/no-useless-fallback-in-spread": "off",
    "unicorn/no-useless-length-check": "off",
    "unicorn/prefer-array-find": "off",
    "unicorn/prefer-array-flat-map": "off",
    "unicorn/prefer-set-has": "off",
    "unicorn/prefer-set-size": "off",
    "unicorn/prefer-string-starts-ends-with": "off",
    "unicorn/require-module-specifiers": "off",
    "unicorn/require-post-message-target-origin": "off",
  },
}
