{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oxytype-api-staging",
  "main": "src/worker.ts",
  "account_id": "eb2679ce4f23ae7db4e6c4e3fcf8c3c1",
  "compatibility_date": "2026-10-02",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": false,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "queues": {
    "producers": [
      {
        "binding": "TASKS",
        "queue": "oxytype-staging-tasks"
      }
    ],
    "consumers": [
      {
        "queue": "oxytype-staging-tasks",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "max_concurrency": 1,
        "dead_letter_queue": "oxytype-staging-dlq"
      }
    ]
  },
  "vars": {
    "MODE": "production",
    "VERSION": "staging",
    "FRONTEND_URL": "https://oxytype-api-staging.voltcrash.workers.dev",
    "BETTER_AUTH_URL": "https://oxytype-api-staging.voltcrash.workers.dev/api/auth"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "oxytype-staging",
      "database_id": "17b0ae8b-92bf-4d7e-a29e-0ac4cc6f2b59",
      "migrations_dir": "../backend/migrations"
    }
  ],
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true
}
