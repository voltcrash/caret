{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oxytype",
  "main": "src/worker.ts",
  "account_id": "eb2679ce4f23ae7db4e6c4e3fcf8c3c1",
  "compatibility_date": "2026-10-02",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "oxytype.voltcrash.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": false,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "triggers": {
    "crons": ["*/15 * * * *", "0 * * * *"]
  },
  "vars": {
    "MODE": "production",
    "FRONTEND_URL": "https://oxytype.voltcrash.com",
    "BETTER_AUTH_URL": "https://oxytype.voltcrash.com/api/auth",
    "VERSION": "production"
  },
  "secrets": {
    "required": [
      "BETTER_AUTH_SECRET",
      "TURNSTILE_SECRET_KEY",
      "GITHUB_CLIENT_ID",
      "GITHUB_CLIENT_SECRET"
    ]
  },
  "ratelimits": [
    {
      "name": "RATE_LIMIT_10S_2",
      "namespace_id": "1001",
      "simple": {
        "limit": 2,
        "period": 10
      }
    },
    {
      "name": "RATE_LIMIT_10S_3",
      "namespace_id": "1002",
      "simple": {
        "limit": 3,
        "period": 10
      }
    },
    {
      "name": "RATE_LIMIT_10S_100",
      "namespace_id": "1003",
      "simple": {
        "limit": 100,
        "period": 10
      }
    },
    {
      "name": "RATE_LIMIT_60S_1",
      "namespace_id": "1004",
      "simple": {
        "limit": 1,
        "period": 60
      }
    },
    {
      "name": "RATE_LIMIT_60S_2",
      "namespace_id": "1005",
      "simple": {
        "limit": 2,
        "period": 60
      }
    },
    {
      "name": "RATE_LIMIT_60S_4",
      "namespace_id": "1006",
      "simple": {
        "limit": 4,
        "period": 60
      }
    },
    {
      "name": "RATE_LIMIT_60S_7",
      "namespace_id": "1007",
      "simple": {
