{
  "name": "@oxytype/backend",
  "version": "1.14.3",
  "private": true,
  "license": "GPL-3.0",
  "exports": {
    "./runtime": "./src/runtime/env.ts",
    "./jobs": "./src/runtime/tasks.ts",
    "./rate-counter": "./src/policies/rate-counter.ts",
    "./client-ip": "./src/policies/client-ip.ts",
    "./auth": "./src/auth/handler.ts",
    "./ip-key": "./src/policies/ip-key.ts",
    "./auth/session": "./src/init/auth.ts",
    "./policies/operations": "./src/policies/operations.ts",
    "./policies/authentication": "./src/policies/authentication.ts",
    "./policies/configuration": "./src/policies/configuration.ts",
    "./policies/permission": "./src/policies/permission.ts",
    "./policies/rate-limit": "./src/policies/rate-limit.ts",
    "./configuration": "./src/init/configuration.ts",
    "./services/context": "./src/services/context.ts",
    "./services/public-operations": "./src/services/operations/public.ts",
    "./services/user-data": "./src/services/operations/user/data.ts",
    "./errors": "./src/utils/error.ts",
    "./audit": "./src/dal/logs.ts",
    "./services/account": "./src/services/operations/user/account.ts",
    "./services/admin": "./src/services/operations/admin.ts",
    "./services/profile": "./src/services/operations/user/profile.ts",
    "./services/leaderboards": "./src/services/operations/leaderboard.ts",
    "./auth/ui-session": "./src/auth/ui-session.ts",
    "./legacy-http": "./src/app.ts"
  },
  "scripts": {
    "lint": "vp lint . --type-aware --type-check --format agent",
    "lint-fast": "vp lint . --format agent",
    "build": "vp run gen-docs && tsx scripts/build-assets.ts && wrangler deploy --dry-run --outdir dist/worker",
    "watch": "wrangler dev --port 5005",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "ts-check": "vp lint . --type-aware --type-check --format agent",
    "start": "wrangler dev --port 5005",
    "test": "vp test run --project=unit",
    "integration-test": "vp test run --project=d1",
    "test-coverage": "vp test run --config coverage.config.ts --coverage",
    "dev": "vp run gen-docs && tsx scripts/build-assets.ts && wrangler dev --port 5005",
    "anticheat:calibrate": "tsx scripts/anticheat-calibrate.ts",
    "gen-docs": "tsx scripts/openapi.ts dist/static/api/openapi.json && redocly build-docs -o dist/static/api/internal.html internal@v2 && redocly bundle -o dist/static/api/public.json public-filter && redocly build-docs -o dist/static/api/public.html public@v2",
    "build:worker": "wrangler deploy --dry-run --outdir dist/worker",
    "deploy:worker": "wrangler deploy",
    "prepare:site": "tsx scripts/prepare-site.ts",
    "check:production": "tsx scripts/check-production.ts",
    "build:production-site": "tsx scripts/build-production-site.ts",
    "deploy:production-site": "vp run check:production && vp run prepare:site && wrangler deploy --config wrangler.production.json --secrets-file .dev.vars.production",
    "deploy:production-dry-run": "vp run check:production && vp run prepare:site && wrangler deploy --config wrangler.production.json --secrets-file .dev.vars.production --dry-run --outdir dist/production-worker",
    "deploy:staging-site": "vp run prepare:site && wrangler deploy --var SERVE_FRONTEND:true --var FRONTEND_URL:https://oxytype-api-staging.voltcrash.workers.dev",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply oxytype-staging --local",
    "db:migrate:remote": "wrangler d1 migrations apply oxytype-staging --remote",
    "db:migrate:production": "wrangler d1 migrations apply oxytype-production --remote --config wrangler.production.json",
    "db:bootstrap:production": "wrangler d1 execute oxytype-production --remote --config wrangler.production.json --file bootstrap/production.sql",
    "db:audit-ape-key-hashes": "wrangler d1 execute oxytype-staging --remote --command=\"$(cat scripts/audit-ape-key-hashes.sql)\" --json",
    "db:audit-ape-key-hashes:production": "wrangler d1 execute oxytype-production --remote --config wrangler.production.json --command=\"$(cat scripts/audit-ape-key-hashes.sql)\" --json",
    "migration-inventory": "tsx scripts/migration-inventory.ts",
    "benchmark-migration": "tsx scripts/migration-baseline.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.7",
    "@better-auth/infra": "0.4.14",
    "@date-fns/utc": "2.1.1",
    "@oxytype/contracts": "workspace:*",
    "@oxytype/funbox": "workspace:*",
    "@oxytype/schemas": "workspace:*",
    "@oxytype/util": "workspace:*",
    "@ts-rest/core": "3.52.1",
    "@ts-rest/open-api": "3.52.1",
    "better-auth": "1.7.7",
    "date-fns": "4.4.0",
    "drizzle-orm": "0.45.3",
    "etag": "1.8.1",
    "hono": "4.13.12",
    "ip-address": "10.7.2",
    "object-hash": "3.0.0",
    "qs": "6.16.0",
    "string-similarity": "4.0.4",
    "ua-parser-js": "2.0.10",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261001.1",
    "@hono/node-server": "2.1.3",
    "@oxytype/oxlint-config": "workspace:*",
    "@oxytype/typescript-config": "workspace:*",
    "@redocly/cli": "2.57.0",
    "@types/etag": "1.8.4",
    "@types/node": "24.19.0",
    "@types/object-hash": "3.0.6",
    "@types/qs": "6.15.1",
    "@types/string-similarity": "4.0.2",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "catalog:",
    "drizzle-kit": "0.31.11",
    "miniflare": "5.20261001.0-alpha",
    "supertest": "7.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "wrangler": "4.146.0"
  },
  "engines": {
    "node": ">=24.21.0 <25"
  }
}
