{
  "extends": "@oxytype/typescript-config/base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "target": "ES2022",
    // Bundled into the Worker by Vite; ESM workspace sources import extensionless.
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "types": ["node"],
    "lib": ["ES2022", "DOM"],
    "noImplicitAny": false,
    "strictFunctionTypes": false,
    "useUnknownInCatchVariables": false,
    "strictPropertyInitialization": false
  },
  "include": ["src"],
  "exclude": [
    "node_modules",
    "build",
    "worker.js",
    "setup-tests.ts",
    "**/*.spec.ts"
  ]
}
