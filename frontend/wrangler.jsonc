{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oxytype-start-migration",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-02",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "upload_source_maps": true,
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": false,
    "html_handling": "none",
    "not_found_handling": "none",
  },
  "vars": {
    "MODE": "dev",
    "FRONTEND_URL": "http://localhost:3000",
    "BETTER_AUTH_URL": "http://localhost:3000/api/auth",
    "VERSION": "start-migration",
  },
  // Namespace IDs are account-wide: production 1xxx, staging 2xxx, local 3xxx.
  "ratelimits": [
    {
      "name": "RATE_LIMIT_10S_2",
      "namespace_id": "3001",
      "simple": {
        "limit": 2,
        "period": 10,
      },
    },
    {
      "name": "RATE_LIMIT_10S_3",
      "namespace_id": "3002",
      "simple": {
        "limit": 3,
        "period": 10,
      },
    },
    {
      "name": "RATE_LIMIT_10S_100",
      "namespace_id": "3003",
      "simple": {
        "limit": 100,
        "period": 10,
      },
    },
    {
      "name": "RATE_LIMIT_60S_2",
      "namespace_id": "3005",
      "simple": {
        "limit": 2,
        "period": 60,
      },
    },
    {
      "name": "RATE_LIMIT_60S_3",
      "namespace_id": "3013",
      "simple": {
        "limit": 3,
        "period": 60,
      },
    },
    {
      "name": "RATE_LIMIT_60S_5",
      "namespace_id": "3014",
      "simple": {
        "limit": 5,
        "period": 60,
      },
    },
    {
      "name": "RATE_LIMIT_60S_10",
      "namespace_id": "3015",
      "simple": {
        "limit": 10,
        "period": 60,
      },
    },
    {
      "name": "RATE_LIMIT_60S_30",
      "namespace_id": "3016",
      "simple": {
        "limit": 30,
        "period": 60,
      },
    },
    {
      "name": "RATE_LIMIT_60S_34",
      "namespace_id": "3010",
      "simple": {
        "limit": 34,
        "period": 60,
      },
    },
    {
      "name": "RATE_LIMIT_60S_60",
      "namespace_id": "3011",
      "simple": {
        "limit": 60,
        "period": 60,
      },
    },
    {
      "name": "RATE_LIMIT_60S_67",
      "namespace_id": "3012",
      "simple": {
        "limit": 67,
        "period": 60,
      },
    },
  ],
  "analytics_engine_datasets": [
    { "binding": "METRICS", "dataset": "oxytype_local_requests" },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "oxytype-staging",
      "database_id": "17b0ae8b-92bf-4d7e-a29e-0ac4cc6f2b59",
      "migrations_dir": "../backend/migrations",
    },
  ],
  "triggers": { "crons": ["*/15 * * * *", "0 * * * *"] },
}
