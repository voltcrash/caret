{
  "name": "@oxytype/frontend",
  "private": true,
  "license": "GPL-3.0",
  "type": "module",
  "scripts": {
    "lint": "vp lint . --type-aware --type-check --format agent",
    "lint-fast": "vp lint . --format agent",
    "lint-styles": "stylelint \"**/*.css\"",
    "lint-styles-fix": "stylelint \"**/*.css\" --fix",
    "check-assets": "tsx ./scripts/check-assets.ts",
    "audit": "vite-bundle-visualizer",
    "measure-eager-js": "tsx scripts/measure-eager-js.ts",
    "dep-graph": "madge -c -i \"dep-graph.png\" ./src/ts",
    "ts-check": "vp lint . --type-aware --type-check --format agent",
    "build": "vp run madge && vp build",
    "madge": "madge --circular --extensions ts,tsx --exclude \"routeTree\\\\.gen\\\\.ts$\" ./src",
    "start": "vp preview --port 3000",
    "dev": "vp dev",
    "test": "vp test run",
    "test-e2e": "playwright test --config playwright.start.config.ts",
    "test-coverage": "vp test run --coverage",
    "dev-test": "concurrently --kill-others \"vp dev\" \"vp test watch\"",
    "tsc": "tsc",
    "storybook": "vp run @oxytype/frontend-storybook#storybook",
    "import-tree": "tsx ./scripts/import-tree.ts",
    "generate-icon-types": "tsx scripts/generate-fontawesome-types.ts",
    "benchmark-word-rendering": "playwright test --config playwright.benchmark.config.ts",
    "benchmark-word-rendering:start": "playwright test --config playwright.start-benchmark.config.ts",
    "benchmark-migration": "playwright test --config playwright.migration.config.ts",
    "benchmark-migration:start": "playwright test --config playwright.start-migration.config.ts",
    "migration-performance": "tsx scripts/migration-performance.ts",
    "build:start": "vp build",
    "dev:legacy": "vp dev --config vite.legacy.config.ts",
    "dev:offline": "vp dev --mode offline",
    "build:start:test": "vp build --mode runtime-test",
    "test:start": "vp test run --config vitest.start.config.ts",
    "test:start:browser": "playwright test --config playwright.start.config.ts",
    "dry-run:start": "wrangler deploy --config dist/start/server/wrangler.json --dry-run --outdir dist/start-dry-run",
    "build:start:staging": "OXYTYPE_DEPLOY_ENV=staging vp build",
    "build:legacy": "vp run madge && vp build --config vite.legacy.config.ts",
    "test-e2e:legacy": "playwright test",
    "build:start:migration": "CLOUDFLARE_ENV=migration vp build",
    "check:production": "tsx scripts/check-production.ts",
    "build:production-site": "tsx scripts/build-production-site.ts",
    "deploy:production-site": "vp run check:production && wrangler deploy --config dist/start/server/wrangler.json --secrets-file .dev.vars.production",
    "deploy:production-dry-run": "vp run check:production && wrangler deploy --config dist/start/server/wrangler.json --dry-run --outdir dist/production-worker",
    "deploy:staging-site": "vp run check:staging && wrangler deploy --config dist/start/server/wrangler.json --secrets-file .dev.vars.staging",
    "db:migrate": "wrangler d1 migrations apply oxytype-staging --local --persist-to ../backend/.wrangler/state",
    "db:migrate:staging": "wrangler d1 migrations apply oxytype-staging --remote --config wrangler.staging.json",
    "db:migrate:production": "wrangler d1 migrations apply oxytype-production --remote --config wrangler.production.json",
    "build:staging-site": "tsx scripts/build-staging-site.ts",
    "check:staging": "tsx scripts/check-staging.ts",
    "test:updates": "tsx scripts/build-update-fixtures.ts && playwright test --config playwright.update.config.ts",
    "test:staging:browser": "playwright test --config playwright.staging.config.ts",
    "check:staging:runtime": "tsx scripts/check-staging-runtime.ts"
  },
  "dependencies": {
    "@better-auth/infra": "0.4.14",
    "@date-fns/utc": "2.1.1",
    "@leonabcd123/modern-caps-lock": "3.1.7",
    "@oxytype/backend": "workspace:*",
    "@oxytype/challenges": "workspace:*",
    "@oxytype/contracts": "workspace:*",
    "@oxytype/funbox": "workspace:*",
    "@oxytype/schemas": "workspace:*",
    "@oxytype/typing-core": "workspace:*",
    "@oxytype/util": "workspace:*",
    "@sentry/browser": "11.1.0",
    "@sentry/vite-plugin": "5.4.0",
    "@solid-primitives/refs": "1.1.4",
    "@solid-primitives/transition-group": "1.1.2",
    "@solidjs/meta": "0.29.4",
    "@solidjs/router": "1.0.0",
    "@tanstack/pacer-lite": "0.3.0",
    "@tanstack/query-db-collection": "1.3.1",
    "@tanstack/solid-db": "0.3.0",
    "@tanstack/solid-form": "1.33.5",
    "@tanstack/solid-hotkeys": "0.12.1",
    "@tanstack/solid-query": "5.104.0",
    "@tanstack/solid-router": "1.170.41",
    "@tanstack/solid-router-ssr-query": "1.167.3",
    "@tanstack/solid-start": "1.169.2",
    "@tanstack/solid-table": "9.2.4",
    "@ts-rest/core": "3.52.1",
    "animejs": "4.5.0",
    "balloon-css": "1.2.0",
    "better-auth": "1.7.7",
    "canvas-confetti": "1.9.4",
    "chart.js": "4.5.1",
    "chartjs-adapter-date-fns": "3.0.0",
    "chartjs-plugin-annotation": "3.1.0",
    "chartjs-plugin-trendline": "3.2.13",
    "clsx": "2.1.1",
    "damerau-levenshtein": "1.0.8",
    "date-fns": "4.4.0",
    "hangul-js": "0.2.6",
    "howler": "2.2.4",
    "idb": "8.0.3",
    "lz-ts": "1.1.2",
    "modern-screenshot": "4.7.0",
    "object-hash": "3.0.0",
    "stemmer": "2.0.1",
    "tailwind-merge": "3.7.0",
    "throttle-debounce": "5.0.2",
    "zod": "4.6.5",
    "zod-urlsearchparams": "0.0.16"
  },
  "devDependencies": {
    "@actions/core": "3.0.1",
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/vite-plugin": "1.62.0",
    "@cloudflare/workers-types": "5.20261001.1",
    "@fortawesome/fontawesome-free": "7.3.1",
    "@oxytype/oxlint-config": "workspace:*",
    "@oxytype/typescript-config": "workspace:*",
    "@solid-devtools/overlay": "0.33.5",
    "@solidjs/testing-library": "0.8.10",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/eslint-plugin-query": "5.104.0",
    "@tanstack/router-generator": "1.167.44",
    "@tanstack/solid-devtools": "0.8.13",
    "@tanstack/solid-hotkeys-devtools": "0.9.1",
    "@tanstack/solid-query-devtools": "5.104.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/user-event": "14.6.7",
    "@types/canvas-confetti": "1.9.0",
    "@types/chartjs-plugin-trendline": "1.0.4",
    "@types/damerau-levenshtein": "1.0.2",
    "@types/howler": "2.2.13",
    "@types/node": "24.19.0",
    "@types/object-hash": "3.0.6",
    "@types/subset-font": "2.3.0",
    "@types/throttle-debounce": "5.0.2",
    "@vitest/coverage-v8": "catalog:",
    "caniuse-lite": "1.0.30001814",
    "concurrently": "10.0.5",
    "eslint-plugin-compat": "7.0.2",
    "eslint-plugin-solid": "0.18.0",
    "fontawesome-subset": "4.6.0",
    "happy-dom": "20.14.5",
    "jsdom": "30.1.1",
    "madge": "8.0.0",
    "miniflare": "5.20261001.0-alpha",
    "normalize.css": "8.0.1",
    "playwright": "catalog:",
    "seroval": "1.6.9",
    "solid-devtools": "0.34.5",
    "solid-js": "1.9.15",
    "subset-font": "2.9.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "unplugin-inject-preload": "3.0.0",
    "vite": "catalog:",
    "vite-bundle-visualizer": "1.2.1",
    "vite-plugin-html-inject": "1.1.2",
    "vite-plugin-inspect": "12.0.2",
    "vite-plugin-minify": "3.0.0",
    "vite-plugin-pwa": "1.3.0",
    "vite-plugin-solid": "2.11.14",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "wrangler": "4.146.0"
  },
  "lint-staged": {
    "*": [
      "vp fmt --no-error-on-unmatched-pattern"
    ],
    "*.{ts,js,tsx}": [
      "vp lint --type-aware --type-check --format agent"
    ]
  },
  "browserslist": [
    "baseline widely available and > 0.002%"
  ],
  "engines": {
    "node": ">=24.21.0 <25"
  }
}
