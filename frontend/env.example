# Copy to frontend/.env for local development.
# Official production settings: frontend/.env.production.example.
# Cloudflare test widget for local development. Production builds require a real site key.
TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Optional Caret-owned Sentry project. No telemetry is sent without a DSN.
# SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
