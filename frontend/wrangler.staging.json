{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "caret-api-staging",
  "main": "src/worker.ts",
  "account_id": "eb2679ce4f23ae7db4e6c4e3fcf8c3c1",
  "compatibility_date": "2026-10-02",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": false,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "triggers": {
    "crons": [
      "*/15 * * * *",
      "0 * * * *"
    ]
  },
  "vars": {
    "MODE": "production",
    "VERSION": "staging",
    "FRONTEND_URL": "https://caret-api-staging.voltcrash.workers.dev",
    "BETTER_AUTH_URL": "https://caret-api-staging.voltcrash.workers.dev/api/auth"
  },
  "ratelimits": [
    {
      "name": "RATE_LIMIT_10S_2",
      "namespace_id": "2001",
      "simple": {
        "limit": 2,
        "period": 10
      }
    },
    {
      "name": "RATE_LIMIT_10S_3",
      "namespace_id": "2002",
      "simple": {
        "limit": 3,
        "period": 10
      }
    },
    {
      "name": "RATE_LIMIT_10S_100",
      "namespace_id": "2003",
      "simple": {
        "limit": 100,
        "period": 10
      }
    },
    {
      "name": "RATE_LIMIT_60S_2",
      "namespace_id": "2005",
      "simple": {
        "limit": 2,
        "period": 60
      }
    },
    {
      "name": "RATE_LIMIT_60S_3",
      "namespace_id": "2013",
      "simple": {
        "limit": 3,
        "period": 60
      }
    },
    {
      "name": "RATE_LIMIT_60S_5",
      "namespace_id": "2014",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "RATE_LIMIT_60S_10",
      "namespace_id": "2015",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "RATE_LIMIT_60S_30",
      "namespace_id": "2016",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "RATE_LIMIT_60S_34",
      "namespace_id": "2010",
      "simple": {
        "limit": 34,
        "period": 60
      }
    },
    {
      "name": "RATE_LIMIT_60S_60",
      "namespace_id": "2011",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "RATE_LIMIT_60S_67",
      "namespace_id": "2012",
      "simple": {
        "limit": 67,
        "period": 60
      }
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "METRICS",
      "dataset": "caret_staging_requests"
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "upload_source_maps": true,
  "secrets": {
    "required": [
      "DATABASE_URL"
    ]
  }
}
